# ==========================================================
# CAPFLUX Backend Environment — canonical variables
# ==========================================================

# --- WorkOS (AuthKit) ---
WORKOS_API_KEY=your-workos-api-key
WORKOS_CLIENT_ID=your-workos-client-id
WORKOS_CLIENT_SECRET=your-workos-client-secret
WORKOS_REDIRECT_URI=http://localhost:5173/auth?provider=google
# AuthKit session cookie password (>= 32 chars). SECRET — never commit.
WORKOS_COOKIE_PASSWORD=please-change-me-to-a-random-string-of-at-least-32-chars

# --- Supabase (service-role/secret-key client) ---
# SUPABASE_SECRET_KEY is the canonical variable (service-role key).
# The backend uses it to bypass RLS for tenant-scoped operations after
# authenticating users via WorkOS.
SUPABASE_URL=https://your-supabase-project-url.supabase.co
SUPABASE_SECRET_KEY=your-service-role-secret-key

# --- Server ---
PORT=4000
NODE_ENV=development

# --- CORS ---
# Production: allowlist of origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173
# Development only: set true to allow all origins (never in production).
CORS_ALLOW_ALL=false

# --- Cookies ---
# In production the session cookie is Secure (HTTPS required).
# For local HTTP development, set COOKIE_SECURE=true to opt into Secure
# (requires the site to be served over HTTPS, e.g. via a tunnel).
COOKIE_SECURE=false

# --- Rate limiting ---
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# --- Payments Provider Mode ---
# Controls which provider environment is active.
#   disabled   — all payment operations blocked (503)
#   sandbox    — sandbox/test providers active (DEV default)
#   production — live production providers (requires explicit activation)
PAYMENTS_PROVIDER_MODE=sandbox

# --- Monnify Gateway ---
# Gateway credentials are CAPFLUX infrastructure secrets (server env only).
# They are NEVER stored per school and never exposed to tenants.
# MONNIFY_ENV is 'sandbox' or 'production'.
MONNIFY_ENV=sandbox
MONNIFY_BASE_URL=https://api.monnify.com/api/v1
MONNIFY_API_KEY=your-monnify-api-key
MONNIFY_SECRET_KEY=your-monnify-secret-key
MONNIFY_WEBHOOK_SECRET=your-webhook-secret
MONNIFY_WEBHOOK_IPS=
CAPFLUX_SETTLEMENT_ACCOUNT=your-capflux-settlement-account-number
CAPFLUX_SETTLEMENT_BANK=your-capflux-settlement-bank-name

# --- Paystack Gateway ---
# PAYSTACK_ENV is 'sandbox' or 'production'.
# Secret key (Bearer auth) from Paystack dashboard.
PAYSTACK_ENV=sandbox
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret

# --- KYC encryption (AES-256-GCM key; exactly 32 bytes) ---
KYC_ENCRYPTION_KEY=please-change-me-32-bytes-exactly-!!
