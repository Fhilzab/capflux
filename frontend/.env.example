# CAPFLUX execution mode (sandbox builds ship an isolated demo environment)
#   production — real Supabase/API providers (default; fail-closed on unknown values)
#   sandbox    — isolated demo dataset + in-browser API/payment/KYC simulators
# PUBLISHABLE (non-secret build flag). Invalid explicit values fail startup.
VITE_CAPFLUX_MODE=production

# API Transport selection (sandbox mode only)
#   remote     — network requests to VITE_API_BASE_URL (deployed sandbox default)
#   simulator  — in-browser SandboxApiServer (development/demo only)
# PUBLISHABLE (non-secret build flag). Invalid values fail startup.
# VITE_API_TRANSPORT=remote

# Declared database environment — MUST agree with VITE_CAPFLUX_MODE or the
# app refuses to boot (MODE_DATABASE_MISMATCH).
#   sandbox frontend → VITE_CAPFLUX_DATABASE_ENV=sandbox  (+ SANDBOX Supabase URL/anon key below)
#   production       → VITE_CAPFLUX_DATABASE_ENV=production
# VITE_CAPFLUX_DATABASE_ENV=production

# SANDBOX FRONTEND DEPLOYMENT (Vercel project "CAPFLUX Sandbox Frontend")
#   VITE_CAPFLUX_MODE=sandbox
#   VITE_CAPFLUX_DATABASE_ENV=sandbox
#   VITE_API_TRANSPORT=remote
#   VITE_API_BASE_URL=https://<sandbox-render-app>.onrender.com/api
#   VITE_SUPABASE_URL=<SANDBOX project URL>            (publishable)
#   VITE_SUPABASE_ANON_KEY=<SANDBOX anon/publishable key> (publishable by design)
# NEVER set PSP secrets, service-role keys or WorkOS client secrets here.

# WorkOS Configuration (client-safe only — the backend handles all WorkOS AuthKit API calls)
VITE_WORKOS_CLIENT_ID=your-workos-client-id

# Auth Provider Selection (production only)
#   workos  — WorkOS AuthKit (primary, recommended)
#   supabase — Supabase Auth (legacy fallback/rollback)
# VITE_AUTH_PROVIDER=workos

# Supabase Configuration
VITE_SUPABASE_URL=https://your-supabase-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# API Configuration (Backend server for auth and webhooks)
VITE_API_BASE_URL=http://localhost:4000/api
